{
  "name": "flowcraft",
  "version": "1.0.0",
  "description": "FlowCraft is a lightweight, web-based BPMN workflow designer built to demonstrate modern Angular development, component architecture, REST API integration, and data persistence.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "postinstall": "npm install --prefix frontend && npm install --prefix backend",
    "start:frontend": "npm --prefix frontend start",
    "start:backend": "npm --prefix backend start",
    "start": "concurrently \"npm run start:frontend\" \"npm run start:backend\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KTajerbashi/flowcraft.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/KTajerbashi/flowcraft/issues"
  },
  "homepage": "https://github.com/KTajerbashi/flowcraft#readme",
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
